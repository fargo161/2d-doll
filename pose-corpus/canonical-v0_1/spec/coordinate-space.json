  },
  "identityBoundaries": {
    "pelvis_center": "pose mechanical origin",
    "rig_root": "runtime hierarchy root; not interchangeable with pelvis_center",
    "character_root": "whole-character placement transform; not interchangeable with pelvis_center",
    "canvas_origin": "render convention only"
  },
  "extensions": {}
}
