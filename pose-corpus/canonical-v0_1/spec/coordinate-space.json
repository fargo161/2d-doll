  "units": {
    "canonical": "body_height",
    "neutralAnatomicalStature": 1.0,
    "rasterPixelsPerBodyHeight": 1728
  },
  "mechanicalSpace": {
    "origin": "pelvis_center",
    "axes": {
      "x": "screen_right_positive",
      "y": "up_positive",
