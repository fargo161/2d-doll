{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://2d-doll.local/schemas/pose-corpus/qa-summary-0.1.json",
  "title": "2D Doll pose-corpus QA summary",
  "type": "object",
  "required": [
    "schemaVersion", "corpusId", "corpusIndexSha256", "renderManifestSha256",
    "counts", "issueCounts", "qaArtifacts", "verdict", "limitations",
    "qaSummarySha256"
  ],
  "properties": {
    "schemaVersion": {"const": "2d-doll-pose-corpus-qa-summary-0.1"},
    "corpusId": {"const": "canonical_female_pose_corpus_v0_1"},
    "corpusIndexSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "renderManifestSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "counts": {
      "type": "object",
      "required": ["registered", "producedCandidates", "transformQaPassed", "accepted", "reviewRequired", "blockedSourceDefect", "qaArtifactCount"],
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "issueCounts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "qaArtifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "logicalPath", "sha256", "sidecarLogicalPath", "sidecarSha256", "cellCount"],
        "properties": {
          "logicalPath": {"type": "string", "not": {"pattern": "^[A-Za-z]:|^/"}},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "sidecarLogicalPath": {"type": "string", "not": {"pattern": "^[A-Za-z]:|^/"}},
          "sidecarSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "cellCount": {"type": "integer", "minimum": 1}
        }
      }
    },
    "verdict": {
      "type": "object",
      "required": ["inventoryStatus", "mechanicsStatus", "renderStatus", "workflowValidationStatus"],
      "properties": {
        "inventoryStatus": {"enum": ["passed", "failed"]},
        "mechanicsStatus": {"enum": ["review_required", "resolved"]},
        "renderStatus": {"enum": ["candidates_generated_not_accepted", "accepted"]},
        "workflowValidationStatus": {"enum": ["not_validated", "validated"]}
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "qaSummarySha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
